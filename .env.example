# 墨脉 环境变量示例（复制为 .env 或直接 export）
#
# 服务端点优先从环境变量读，其次读数据库 settings 表（网页「设置」页），
# 两处都没配时后端会抛出可读错误，不会去连某个写死的默认地址。
#
# 下面这些是本机单机部署时的常见取值，按自己的机器改。

# 嵌入服务（OpenAI 兼容 /v1/embeddings；维度必须与 embed_dim 一致）
MOMAI_EMBED_URL=http://127.0.0.1:8002/v1/embeddings

# 版式 OCR（MinerU HTTP API）
MOMAI_MINERU_URL=http://127.0.0.1:8004

# 生成模型（OpenAI 兼容 /v1；对话与写稿都用它）
MOMAI_VLLM_URL=http://127.0.0.1:8001/v1

# 重排服务（llama.cpp /v1/rerank 或等价接口）
MOMAI_RERANK_URL=http://127.0.0.1:8003

# 向量副本（可选；PG 始终是主库，Qdrant 只做第二路召回）
MOMAI_QDRANT_URL=http://127.0.0.1:6333

# ---- 数据库（也可用 settings 页之外的部署变量）----
WENMAI_DB_USER=wenmai_app
WENMAI_DB_PASS=change_me
WENMAI_DB_HOST=127.0.0.1
WENMAI_DB_PORT=5432
WENMAI_DB_NAME=wenmai
